---
import type { InferGetStaticPropsType } from "astro";
import Site from "@/layouts/Site.astro";
import { getProject, getProjects } from "@/lib/sanity";
import { RecordWords, RecordWork } from "@/components/RichText";
import VoiceType from "@/components/VoiceType";
import SpoolPlayer from "@/components/SpoolPlayer";
import Transcript from "@/components/Transcript";
import VideoEmbed from "@/components/VideoEmbed";
import { embeddable, videoBlock, videosIn, type Video } from "@/lib/video";
import { recordLabel } from "@/types/Project";
import { SIZES, dimensionsOf, sized, srcset } from "@/lib/images";
import { groupProjects, placeOf } from "@/lib/group-projects";

/* A project record: the words in a screen-tall column on the left with its content at the
   bottom, stuck under the bar so it sits still while the work scrolls past; the work as a
   stack of images on the right at their own proportions (after laylabaghai.com/probio).
   Phones: words first, then the stack. */

export async function getStaticPaths() {
  const projects = await getProjects();
  const groups = groupProjects(projects);
  return projects.map((p) => ({ params: { project: p.slug }, props: placeOf(groups, p._id) }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { current, projects } = Astro.props as Props;
// the projects either side in the drawer, looping round at the ends. With two projects both sides are the same one, so only next shows
const next = projects.length > 1 ? projects[(current + 1) % projects.length] : null;
const previous = projects.length > 2 ? projects[(current - 1 + projects.length) % projects.length] : null;

const project = await getProject(Astro.params.project!);
if (!project) return Astro.redirect("/404");

const development = project.development ?? [];
// YouTube and Vimeo links anywhere in the record play here instead of on another site
const videos = (await Promise.all([...videosIn(project.description), ...videosIn(project.content)].map(embeddable))).filter(
  (v): v is Video => !!v
);
const embedded = videos.map((v) => v.key);

// The content in runs: text and images between video blocks go through RecordWork, and each video
// block plays where it sits, as an island (it can't hydrate inside the static Portable Text). A block
// whose video can't be embedded (Vimeo with embedding off) stays a plain link to it
type Piece =
  | { kind: "work"; blocks: NonNullable<typeof project.content> }
  | { kind: "video"; video: Video }
  | { kind: "link"; url: string; caption: string; transcript?: string };
const pieces: Piece[] = [];
for (const block of project.content ?? []) {
  const b = block as { _type?: string; _key?: string; url?: string; caption?: string; transcript?: string };
  if (b._type === "video") {
    const v = videoBlock(b);
    const video = v ? await embeddable(v) : null;
    if (video) pieces.push({ kind: "video", video });
    else if (b.url) pieces.push({ kind: "link", url: b.url, caption: b.caption?.trim() || "Video", transcript: b.transcript });
    continue;
  }
  const last = pieces.at(-1);
  if (last?.kind === "work") last.blocks.push(block);
  else pieces.push({ kind: "work", blocks: [block] });
}
// content from before the blocks (photos and paragraphs only) still reads paragraphs as captions
const legacy = !(project.content ?? []).some((b) => ["figure", "pair", "quote"].includes((b as { _type?: string })._type ?? ""));
const hasMeta = !!(project.year || project.materials || project.process || project.location || project.collaborators || project.press?.length);
const meta = [
  ["Materials", project.materials],
  ["Process", project.process],
  ["Location", project.location],
  ["With", project.collaborators],
].filter(([, v]) => v) as [string, string][];
---

<Site title={project.name ?? undefined}>
  <article class="min-h-screen bg-paper text-ink">
    <div class="px-edge pt-24 md:pt-bar pb-12 md:pb-24 grid grid-cols-1 md:grid-cols-12 gap-x-8 lg:gap-x-12 gap-y-10">
      {/* the words: a screen-tall column stuck under the bar with its content at the bottom.
          Nothing scrolls inside it; the type is sized so the longest record fits a laptop window */}
      {/* between the two bars. A window too short for the longest record scrolls the column rather than hiding its end under the project bar */}
      <div class="md:col-span-5 xl:col-span-4 self-start flex flex-col md:sticky md:top-bar md:h-[calc(100svh-2*var(--size-bar))] md:overflow-y-auto md:pb-7 md:pr-4">
        {/* mt-auto, not justify-end, so the top stays reachable when the column has to scroll */}
        <div class="mt-auto flex flex-col gap-3">
          <p class="hp-label text-muted flex flex-wrap gap-x-3">
            <span class="text-ink">{project.parent ? recordLabel(project) : "Project record"}</span>
            {project.year && (
              <>
                <span aria-hidden="true">·</span>
                <span>{project.year}</span>
              </>
            )}
          </p>
          {/* a development record points back to the project it belongs to */}
          {project.parent && (
            <p class="hp-label text-muted">
              Part of{" "}
              <a href={`/projects/${project.parent.slug}`} class="hp-link text-accent">
                {project.parent.name?.trim()}
              </a>
            </p>
          )}
          <h1 class="text-lead leading-tight tracking-tight">
            {/* the title speaks: its letters follow the loudness of whatever is playing */}
            <VoiceType client:visible text={project.name ?? ""} />
          </h1>
          {project.description && (
            <div class="flex flex-col gap-3 max-w-[48ch]">
              <RecordWords value={project.description} embedded={embedded} />
            </div>
          )}
          {!!project.disciplines?.length && (
            <div>
              <p class="hp-label text-muted">Work</p>
              <p class="mt-1 text-small">{project.disciplines.join(", ")}</p>
            </div>
          )}
          {/* the spool only appears when this record has a recording of its own */}
          {project.audio && <SpoolPlayer client:visible src={project.audio} />}
          {project.audio && <Transcript text={project.audioTranscript} label={`${project.name?.trim()} recording`} />}
          {hasMeta && (
            <dl class="border-b border-rule">
              {meta.map(([label, value]) => (
                <div class="grid grid-cols-[6rem_1fr] gap-4 py-3 border-t border-rule">
                  <dt class="hp-label text-muted pt-1">{label}</dt>
                  <dd class="text-body">{value}</dd>
                </div>
              ))}
              {!!project.press?.length && (
                <div class="grid grid-cols-[6rem_1fr] gap-4 py-3 border-t border-rule">
                  <dt class="hp-label text-muted pt-1">Press</dt>
                  <dd class="text-body">
                    {project.press.map((p) => (
                      <a href={p.url} target="_blank" rel="noopener" class="hp-link text-accent">
                        {p.title}
                      </a>
                    ))}
                  </dd>
                </div>
              )}
            </dl>
          )}
        </div>
      </div>

      {/* the work: the lead image, then everything in the record, one stack that grows with the screen */}
      <div class="md:col-span-7 xl:col-span-8 md:pt-bar flex flex-col gap-6 md:gap-8 w-full md:max-w-[min(100%,60vw)]">
        {project.image && (
          <figure style={project.imageColor ? `background-color: ${project.imageColor}` : undefined}>
            <img
              src={sized(project.image, 1280)}
              srcset={srcset(project.image)}
              sizes={SIZES.work}
              {...(dimensionsOf(project.image) ?? {})}
              fetchpriority="high"
              alt={project.imageAlt ?? ""}
              class="hp-img w-full h-auto"
            />
          </figure>
        )}
        {videos.map((video) => <VideoEmbed client:visible video={video} />)}
        {pieces.map((piece) =>
          piece.kind === "work" ? (
            <RecordWork value={piece.blocks} embedded={embedded} legacy={legacy} />
          ) : piece.kind === "video" ? (
            <VideoEmbed client:visible video={piece.video} />
          ) : (
            <div>
              <p class="text-small">
                <a href={piece.url} target="_blank" rel="noopener" class="hp-link text-accent">{piece.caption}</a>
              </p>
              <Transcript text={piece.transcript} label={piece.caption} />
            </div>
          )
        )}

        {/* how it was made: the development records, once the work itself has been seen */}
        {development.length > 0 && (
          <section aria-labelledby="development" class="mt-6 md:mt-16">
            <h2 id="development" class="hp-label text-muted">How it was made</h2>
            <ul class="list-none mt-5 flex flex-col gap-10">
              {development.map((r) => (
                <li class="group relative [&:has(a:focus-visible)]:outline [&:has(a:focus-visible)]:outline-2 [&:has(a:focus-visible)]:outline-offset-4 [&:has(a:focus-visible)]:outline-accent grid grid-cols-1 sm:grid-cols-2 gap-5 sm:gap-8 items-end">
                  {r.image && (
                    <div class="aspect-[4/3] overflow-hidden" style={r.imageColor ? `background-color: ${r.imageColor}` : undefined}>
                      <img
                        src={sized(r.image, 720)}
                        srcset={srcset(r.image)}
                        sizes={SIZES.development}
                        alt=""
                        loading="lazy"
                        decoding="async"
                        class="hp-img w-full h-full object-cover"
                      />
                    </div>
                  )}
                  <div class="flex flex-col gap-2">
                    <h3 class="text-lead leading-tight tracking-tight transition-colors group-hover:text-accent">
                      {/* stretched link: the whole entry opens the record */}
                      <a href={`/projects/${r.slug}`} class="after:absolute after:inset-0 focus-visible:outline-none focus-visible:underline">
                        {recordLabel(r)}
                      </a>
                    </h3>
                    {r.summary && <p class="italic leading-snug max-w-[36ch]">{r.summary}</p>}
                    <p aria-hidden="true" class="hp-label text-accent">
                      Read the record{" "}
                      <span class="inline-block transition-transform duration-300 ease-out group-hover:translate-x-1 motion-reduce:transition-none">→</span>
                    </p>
                  </div>
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>
    </div>

    {/* the project bar along the foot of the screen (after liyakedar.com): back to every project, or on to the
        ones either side. It stays three cells however many projects there are, so it never gets cramped.
        From md it sits on the page's own 12 columns, so its first divider carries the edge of the pictures down */}
    <nav
      aria-label="Projects"
      class="hp-rule sticky bottom-0 z-30 h-bar flex md:grid md:grid-cols-12 md:gap-x-8 lg:gap-x-12 md:px-edge border-t border-ink bg-paper font-mono text-label uppercase tracking-wider"
    >
      {/* md up, the link reaches out over the bar's edge padding and the column gap, so its thread and its
          hover area run rule to rule like the cells beside it */}
      <a href="/" class="group relative flex-1 min-w-0 flex items-center pl-edge pr-4 md:col-span-5 xl:col-span-4 md:-ml-edge md:-mr-8 lg:-mr-12 whitespace-nowrap hover:text-accent transition-colors">
        All projects
        <span aria-hidden="true" class="absolute inset-x-0 -top-px h-0.5 bg-accent origin-left scale-x-0 transition-transform duration-500 ease-out group-hover:scale-x-100 motion-reduce:transition-none"></span>
      </a>
      {/* phones: the two cells sit straight in the bar. md up: they split the pictures' columns in half, ruled off at the left */}
      <div class="contents md:grid md:grid-cols-2 md:col-span-7 xl:col-span-8 md:-mr-edge hp-rule md:border-l border-ink">
        {[
          { label: "Previous", p: previous },
          { label: "Next", p: next },
        ].map(({ label, p }) =>
          p ? (
            <a
              href={`/projects/${p.slug}`}
              class:list={[
                "group relative hp-rule flex items-center gap-3 px-4 md:px-7 last:pr-edge whitespace-nowrap hover:text-accent transition-colors",
                label === "Next" ? "border-l border-ink md:justify-end" : "border-l md:border-l-0 border-ink",
              ]}
            >
              <span>{label}</span>
              <span class="sr-only">: {p.name}</span>
              <span aria-hidden="true" class="absolute inset-x-0 -top-px h-0.5 bg-accent origin-left scale-x-0 transition-transform duration-500 ease-out group-hover:scale-x-100 motion-reduce:transition-none"></span>
            </a>
          ) : null
        )}
      </div>
    </nav>
  </article>
</Site>
