---
import "@/styles/global.css";
import Nav from "@/components/Nav";
import { getPages, getSettings } from "@/lib/sanity";
import { siteSettings } from "@/lib/site";

interface Props {
  title?: string;
  description?: string;
}

// the site's name, description, share image and ambient recording come from Site settings in Studio,
// each falling back to what the site shipped with until it's filled in (lib/site.ts)
const settings = siteSettings(await getSettings());
const { title, description = settings.description } = Astro.props;
const fullTitle = title ? `${title} · ${settings.name}` : settings.homeTitle;
const pages = await getPages();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {settings.shareImage && <meta property="og:image" content={`${settings.shareImage}?w=1200&h=630&fit=crop`} />}
    {settings.shareImageAlt && <meta property="og:image:alt" content={settings.shareImageAlt} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
  </head>
  <body class="relative bg-paper text-ink font-sans">
    {/* the ambient "voice from the yarn": loops while the Sound switch is on and nothing else has the floor (stores/sound.ts) */}
    <audio id="hp-ambient" src={settings.ambient} preload="none" loop></audio>
    {/* the first thing a keyboard reaches: straight past the nav to the page itself */}
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-edge focus:top-3 focus:z-[60] focus:bg-paper focus:text-ink focus:border focus:border-ink focus:px-4 focus:py-2 hp-label"
    >
      Skip to content
    </a>
    <Nav client:load pages={pages} pathname={Astro.url.pathname} />
    {/* the thread: a line along the foot of the nav that grows while the next page loads (lib/loader.ts) */}
    <div class="hp-loader" aria-hidden="true"></div>
    <main id="content" tabindex="-1" class="focus:outline-none">
      <slot />
    </main>
    <script>
      import Lenis from "lenis";
      import "lenis/dist/lenis.css";
      import { startLoader } from "@/lib/loader";

      startLoader();

      // eased, weighted scrolling, as samthies.com and brandonyasin.com have. Lenis only smooths the
      // wheel and trackpad, so phones keep their own scrolling, and it's off for anyone who asks for
      // reduced motion. Anchor links (a record's video links) glide too, and land clear of the nav bar
      // by their own scroll-margin, which Lenis honours.
      // autoToggle pauses it while the phone menu holds the page still. allowNestedScroll lets a record's
      // words column scroll itself on the short windows where it has to
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
        new Lenis({ autoRaf: true, autoToggle: true, allowNestedScroll: true, anchors: true });
      }
    </script>
  </body>
</html>
